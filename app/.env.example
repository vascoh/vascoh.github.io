# LLM — necessário a partir do v1 (Career/CV/LinkedIn/Matching/Apply/Interview/Salary/Email Agent)
ANTHROPIC_API_KEY=
MODEL_REASONING=claude-opus-4-5
MODEL_WRITING=claude-sonnet-5

# Supabase — necessário a partir do v1 para persistência real
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Redis — usado por docker-compose por omissão, ajustar se usares um serviço gerido
REDIS_URL=redis://localhost:6379/0

# Regras de negócio
MATCH_SCORE_PRIORITY_THRESHOLD=70

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
